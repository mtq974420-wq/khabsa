# ============================================================
# KHABSA Platform - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your own values
# NEVER commit .env to version control

# ============================================================
# SUPABASE CONFIGURATION (Required for full functionality)
# ============================================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# APP CONFIGURATION
# ============================================================
VITE_APP_NAME=خَبْصَة
VITE_APP_URL=https://khabsa.app

# ============================================================
# WEBRTC CONFIGURATION (Optional - for voice chat)
# ============================================================
# STUN/TURN servers for WebRTC (defaults to Google STUN)
# For production, use your own TURN server
VITE_STUN_SERVER_1=stun:stun.l.google.com:19302
VITE_STUN_SERVER_2=stun:stun1.l.google.com:19302

# TURN server (optional, improves connectivity behind strict NAT)
# VITE_TURN_SERVER=turn:your-turn-server.com:3478
# VITE_TURN_USERNAME=username
# VITE_TURN_CREDENTIAL=password

# ============================================================
# ANALYTICS (Optional)
# ============================================================
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxx

# ============================================================
# NOTES
# ============================================================
# - The app works in DEMO MODE without Supabase credentials
# - Demo mode uses local state only (rooms won't sync between browsers)
# - For multiplayer to work across devices, Supabase is required
# - Voice chat uses WebRTC and works without additional services
# - For reliable voice across NAT, deploy a TURN server (coturn recommended)
